        <source src="https://assets.mixkit.co/active_storage/sfx/250/250-preview.mp3" type="audio/mp3">
    </audio>
    <audio id="explosionSound">
        <source src="https://assets.mixkit.co/active_storage/sfx/245/245-preview.mp3" type="audio/mp3">
